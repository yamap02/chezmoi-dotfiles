# Keep .zshenv safe for non-interactive shells: only global environment setup.
typeset -U path manpath infopath sudo_path
typeset -a prefer_path
typeset -xT PATH path
typeset -xT MANPATH manpath
typeset -xT INFOPATH infopath
typeset -xT SUDO_PATH sudo_path

if [[ -x /opt/homebrew/bin/brew ]]; then
  # Login shells initialize Homebrew in .zprofile, after macOS path_helper.
  if [[ ! -o login ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
  prefer_path=(/opt/homebrew/opt/coreutils/libexec/gnubin /opt/homebrew/opt/findutils/libexec/gnubin /opt/homebrew/opt/gnu-sed/libexec/gnubin /opt/homebrew/opt/gnu-tar/libexec/gnubin /opt/homebrew/opt/grep/libexec/gnubin /opt/homebrew/opt/unzip/bin /opt/homebrew/bin /opt/homebrew/sbin)
  manpath=(/opt/homebrew/share/man $manpath)
  infopath=(/opt/homebrew/share/info $infopath)
fi

# ユーザー/Homebrew のコマンドを /usr/bin の Apple shim (pip3, python3, gcc 等) より優先する。
# ログインシェルでは /etc/zprofile の path_helper が並べ替えるため、.zprofile で prefer_path を付け直す。
prefer_path=("$HOME/bin"(N-/) "$HOME/.local/bin"(N-/) "$HOME/.cargo/bin"(N-/) "$HOME/.rye/shims"(N-/) "$HOME/.deno/bin"(N-/) "$HOME/.go/bin"(N-/) "$HOME/.volta/bin"(N-/) "$HOME/.pyenv/bin"(N-/) "$HOME/.nimble/bin"(N-/) "$HOME/.rbenv/shims"(N-/) $prefer_path)
path=($prefer_path $path /usr/local/go/bin(N-/) /usr/local/bin(N-/) /usr/bin(N-/) /bin(N-/) /usr/sbin(N-/) /sbin(N-/))
fpath=("$HOME/.config/zsh/zfunc"(N-/) "$HOME/.config/zsh/completion"(N-/) /usr/local/share/zsh/site-functions /usr/share/zsh/site-functions $fpath)

export LESS_TERMCAP_mb=$'\e[1;31m'
export LESS_TERMCAP_md=$'\e[1;33m'
export LESS_TERMCAP_so=$'\e[01;44;37m'
export LESS_TERMCAP_us=$'\e[01;37m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_ue=$'\e[0m'

[[ -r "$HOME/.config/zsh/env.sh" ]] && source "$HOME/.config/zsh/env.sh"
