{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "model": "claude-sonnet-5-5",
  "advisorModel": "claude-opus-5-5",
  "autoUpdatesChannel": "stable",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials.json)"
    ]
  },
  "sandbox": {
    "enabled": true
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "aice-claude-plugins": {
      "source": {
        "source": "git",
        "url": "git@github.com:AICE-inc/aice-claude-plugins.git"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  }
}
